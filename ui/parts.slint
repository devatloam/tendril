import { Theme } from "theme.slint";

export struct Row {
    // 0 is a section heading, 1 an item, 2 the calculator.
    kind: int,
    y: length,
    height: length,
    title: string,
    subtitle: string,
    accessory: string,
    icon: image,
    tint: int,
}

export struct ActionRow {
    title: string,
    icon: image,
    keys: [string],
    danger: bool,
}

export component Keycap inherits Rectangle {
    in property <string> label;
    in property <bool> strong;
    height: 20px;
    min-width: 20px;
    border-radius: 5px;
    background: Theme.ink.with-alpha(strong ? 0.14 : 0.09);
    HorizontalLayout {
        padding-left: 5px;
        padding-right: 5px;
        Text {
            text: label;
            color: strong ? Theme.ink : Theme.ink-2;
            font-size: 11px;
            font-weight: 500;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

// An app's own icon, or a glyph on a tinted square so a list reads by shape and colour first.
export component RowIcon inherits Rectangle {
    in property <image> source;
    in property <int> tint;
    in property <length> size: 20px;
    width: size;
    height: size;
    border-radius: tint == 0 ? 0 : size * 0.26;
    background: tint == 0 ? transparent : Theme.tint(tint).with-alpha(Theme.dark ? 0.2 : 0.16);
    Image {
        width: tint == 0 ? parent.width : parent.width * 0.7;
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: source;
        colorize: tint == 0 ? transparent : Theme.tint(tint);
        image-fit: contain;
    }
}

export component SectionRow inherits Rectangle {
    in property <Row> data;
    Text {
        x: 12px;
        y: parent.height - self.height - 6px;
        text: data.title;
        color: Theme.ink-3;
        font-size: 12px;
        font-weight: 600;
    }
}

export component ItemRow inherits Rectangle {
    in property <Row> data;
    in property <bool> selected;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 14px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            RowIcon {
                source: data.icon;
                tint: data.tint;
            }
        }

        HorizontalLayout {
            spacing: 10px;
            horizontal-stretch: 1;
            Text {
                text: data.title;
                color: Theme.ink;
                font-weight: 500;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 0;
            }

            Text {
                text: data.subtitle;
                color: Theme.ink-3;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }

        Text {
            text: data.accessory;
            color: selected ? Theme.ink-2 : Theme.ink-3;
            font-size: 13px;
            vertical-alignment: center;
        }
    }
}

// The answer to a sum, as two halves with an arrow between: what you typed, and what it comes to.
export component CalcRow inherits Rectangle {
    in property <Row> data;
    in property <bool> selected;
    border-radius: 10px;
    border-width: 1px;
    border-color: selected ? transparent : Theme.line;
    HorizontalLayout {
        padding: 12px;
        spacing: 8px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 6px;
            Text {
                text: data.title;
                color: Theme.ink;
                font-size: 24px;
                font-weight: 500;
                horizontal-alignment: center;
                overflow: elide;
            }

            Text {
                text: "Expression";
                color: Theme.ink-3;
                font-size: 12px;
                horizontal-alignment: center;
            }
        }

        VerticalLayout {
            alignment: center;
            Image {
                width: 20px;
                height: 20px;
                source: @image-url("icons/arrow.svg");
                colorize: Theme.ink-3;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 6px;
            Text {
                text: data.subtitle;
                color: Theme.ink;
                font-size: 24px;
                font-weight: 600;
                horizontal-alignment: center;
                overflow: elide;
            }

            Text {
                text: data.accessory;
                color: Theme.ink-3;
                font-size: 12px;
                horizontal-alignment: center;
            }
        }
    }
}

export component ActionPanel inherits Rectangle {
    in property <[ActionRow]> actions;
    in property <int> selected;
    in property <string> title;
    in-out property <string> query;
    callback edited(string);
    callback hover(int);
    callback run(int);
    public function focus-field() {
        field.focus();
    }
    public function clear-field-focus() {
        field.clear-focus();
    }

    property <length> row-height: 34px;
    width: 320px;
    height: min(actions.length, 8) * row-height + 12px + 28px + 45px;
    border-radius: 12px;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.line;
    drop-shadow-blur: 24px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: #00000066;
    clip: true;

    Text {
        x: 14px;
        y: 10px;
        height: 22px;
        text: title;
        color: Theme.ink-3;
        font-size: 12px;
        font-weight: 600;
        vertical-alignment: center;
        overflow: elide;
        width: parent.width - 28px;
    }

    list := Flickable {
        x: 6px;
        y: 34px;
        width: parent.width - 12px;
        height: min(actions.length, 8) * row-height;
        content-height: actions.length * row-height;
        for action[i] in actions: Rectangle {
            y: i * row-height;
            height: row-height;
            border-radius: 7px;
            background: i == selected ? Theme.raised : transparent;
            TouchArea {
                pointer-event(e) => {
                    if e.kind == PointerEventKind.move && i != selected {
                        root.hover(i);
                    }
                }
                clicked => {
                    root.run(i);
                }
            }

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 8px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    Image {
                        width: 16px;
                        height: 16px;
                        source: action.icon;
                        colorize: action.danger ? Theme.red : Theme.ink-2;
                    }
                }

                Text {
                    text: action.title;
                    color: action.danger ? Theme.red : Theme.ink;
                    font-size: 13px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                HorizontalLayout {
                    spacing: 3px;
                    alignment: end;
                    padding-top: (row-height - 20px) / 2;
                    padding-bottom: (row-height - 20px) / 2;
                    for key in action.keys: Keycap {
                        label: key;
                    }
                }
            }
        }
    }

    // Keep the picked action in view when the list scrolls.
    changed selected => {
        if selected * row-height < -list.content-y {
            list.content-y = -selected * row-height;
        } else if (selected + 1) * row-height > -list.content-y + list.height {
            list.content-y = -((selected + 1) * row-height - list.height);
        }
    }

    Rectangle {
        y: parent.height - 45px;
        height: 1px;
        background: Theme.line;
    }

    Rectangle {
        y: parent.height - 44px;
        height: 44px;
        field := TextInput {
            x: 14px;
            width: parent.width - 28px;
            text <=> root.query;
            color: Theme.ink;
            font-size: 13px;
            vertical-alignment: center;
            single-line: true;
            selection-background-color: Theme.blue.with-alpha(0.35);
            edited => {
                root.edited(self.text);
            }
        }

        Text {
            x: 14px;
            text: "Search for actions…";
            color: Theme.ink-3;
            font-size: 13px;
            vertical-alignment: center;
            visible: root.query == "";
        }
    }
}

export component ConfirmDialog inherits Rectangle {
    in property <string> title;
    in property <string> message;
    in property <string> label;
    in property <image> icon;
    callback answer(bool);
    background: #00000059;
    TouchArea {
        clicked => {
            root.answer(false);
        }
    }

    card := Rectangle {
        width: 340px;
        height: layout.preferred-height;
        border-radius: 14px;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.line;
        drop-shadow-blur: 32px;
        drop-shadow-offset-y: 12px;
        drop-shadow-color: #00000080;
        // Swallow clicks so only the dimmed area cancels.
        TouchArea { }

        layout := VerticalLayout {
            padding: 20px;
            padding-top: 22px;
            spacing: 10px;
            HorizontalLayout {
                alignment: center;
                RowIcon {
                    source: icon;
                    tint: 4;
                    size: 40px;
                }
            }

            Text {
                text: title;
                color: Theme.ink;
                font-size: 15px;
                font-weight: 600;
                horizontal-alignment: center;
            }

            Text {
                text: message;
                color: Theme.ink-2;
                font-size: 13px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            HorizontalLayout {
                padding-top: 8px;
                spacing: 8px;
                Rectangle {
                    height: 34px;
                    horizontal-stretch: 1;
                    border-radius: 8px;
                    background: cancel-touch.has-hover ? Theme.raised.brighter(0.08) : Theme.raised;
                    cancel-touch := TouchArea {
                        clicked => {
                            root.answer(false);
                        }
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        Text {
                            text: "Cancel";
                            color: Theme.ink;
                            font-size: 13px;
                            font-weight: 500;
                            vertical-alignment: center;
                        }

                        VerticalLayout {
                            alignment: center;
                            Keycap {
                                label: "Esc";
                                strong: true;
                            }
                        }
                    }
                }

                Rectangle {
                    height: 34px;
                    horizontal-stretch: 1;
                    border-radius: 8px;
                    background: Theme.red.with-alpha(ok-touch.has-hover ? 0.26 : 0.18);
                    ok-touch := TouchArea {
                        clicked => {
                            root.answer(true);
                        }
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        Text {
                            text: label;
                            color: Theme.red;
                            font-size: 13px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }

                        VerticalLayout {
                            alignment: center;
                            Keycap {
                                label: "↵";
                                strong: true;
                            }
                        }
                    }
                }
            }
        }
    }
}
