// Tendril's Settings window, in the manner of Raycast's: tabs down the side, each setting a row
// with its control on the right, saved the moment it changes. Made when it's opened and gone when
// it's closed (settings.rs), so it costs nothing the rest of the time.

import { Theme } from "theme.slint";
import { Keycap, ConfirmDialog } from "parts.slint";

export struct Choice {
    key: string,
    title: string,
    about: string,
    labels: [string],
    current: int,
    // On and Off, drawn as a switch.
    toggle: bool,
}

export struct ChoiceGroup {
    title: string,
    choices: [Choice],
}

export struct Entry {
    name: string,
    keyword: string,
    url: string,
}

// Windows 11's own design, used on Windows (settings.rs turns it on): its neutral colours, the
// accent you picked in Windows, Segoe UI, a card for each setting, and Mica when Tendril draws
// with the GPU. Elsewhere the window keeps Tendril's look.
export global Look {
    in property <bool> fluent;
    in property <bool> mica;
    // Windows' own accent shades: the light one shows on dark, the dark one on light.
    in property <color> accent-on-dark: #60cdff;
    in property <color> accent-on-light: #005fb8;
    out property <color> accent: Theme.dark ? accent-on-dark : accent-on-light;
    out property <color> on-accent: Theme.dark ? #000000 : #ffffff;
    out property <color> base: Theme.dark ? #202020 : #f3f3f3;
    out property <color> card: Theme.dark ? #ffffff0d : #ffffffb3;
    out property <color> card-stroke: Theme.dark ? #0000001a : #0000000f;
    out property <color> control: Theme.dark ? #ffffff0f : #ffffffb3;
    out property <color> control-hover: Theme.dark ? #ffffff15 : #f9f9f9;
    out property <color> control-pressed: Theme.dark ? #ffffff08 : #f9f9f94d;
    out property <color> control-stroke: Theme.dark ? #ffffff12 : #0000000f;
    out property <color> subtle: Theme.dark ? #ffffff0f : #00000009;
    out property <color> ink: Theme.dark ? #ffffff : #000000e4;
    out property <color> ink-2: Theme.dark ? #ffffffc5 : #0000009e;
    out property <color> ink-3: Theme.dark ? #ffffff87 : #00000072;
    out property <color> strong-stroke: Theme.dark ? #ffffff9b : #00000072;
}

component Switch inherits Rectangle {
    in property <bool> on;
    callback toggled();
    width: Look.fluent ? 40px : 36px;
    height: 20px;
    border-radius: 10px;
    background: Look.fluent
        ? (root.on ? (touch.has-hover ? Look.accent.with-alpha(0.9) : Look.accent) : (touch.has-hover ? Look.subtle : transparent))
        : (root.on ? Theme.highlight : Theme.ink.with-alpha(Theme.dark ? 0.18 : 0.16));
    border-width: Look.fluent && !root.on ? 1px : 0px;
    border-color: Look.strong-stroke;
    animate background { duration: 120ms; }
    Rectangle {
        // Windows grows the knob under the pointer.
        property <length> size: Look.fluent ? (touch.has-hover ? 14px : 12px) : 16px;
        width: self.size;
        height: self.size;
        border-radius: self.size / 2;
        y: (root.height - self.size) / 2;
        x: (root.on ? root.width - 10px : 10px) - self.size / 2;
        background: Look.fluent ? (root.on ? Look.on-accent : Look.strong-stroke) : #ffffff;
        drop-shadow-blur: Look.fluent ? 0px : 2px;
        drop-shadow-color: #00000040;
        animate x, width, height {
            duration: 120ms;
            easing: cubic-bezier(0.2, 0, 0, 1);
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.toggled();
        }
    }
}

// A few choices side by side. Tendril's: the chosen one raised. Windows': as the Community
// Toolkit's Segmented control, with an accent pill under the chosen one.
component Segmented inherits Rectangle {
    in property <[string]> labels;
    in property <int> current;
    callback chosen(int);
    height: Look.fluent ? 32px : 28px;
    border-radius: Look.fluent ? 5px : 7px;
    background: Look.fluent ? Look.subtle : Theme.ink.with-alpha(Theme.dark ? 0.07 : 0.06);
    border-width: Look.fluent ? 1px : 0px;
    border-color: Look.control-stroke;
    HorizontalLayout {
        padding: Look.fluent ? 3px : 2px;
        spacing: 2px;
        for label[i] in root.labels: Rectangle {
            border-radius: Look.fluent ? 3px : 5px;
            background: Look.fluent
                ? (i == root.current ? Look.control : touch.has-hover ? Look.subtle : transparent)
                : (i == root.current ? (Theme.dark ? Theme.ink.with-alpha(0.15) : #ffffff) : (touch.has-hover ? Theme.ink.with-alpha(0.05) : transparent));
            border-width: Look.fluent && i == root.current ? 1px : 0px;
            border-color: Look.control-stroke;
            drop-shadow-blur: i == root.current && !Theme.dark && !Look.fluent ? 2px : 0;
            drop-shadow-color: #00000026;
            HorizontalLayout {
                padding-left: Look.fluent ? 12px : 10px;
                padding-right: Look.fluent ? 12px : 10px;
                Text {
                    text: label;
                    color: Look.fluent ? (i == root.current ? Look.ink : Look.ink-2) : (i == root.current ? Theme.ink : Theme.ink-2);
                    font-size: Look.fluent ? 13px : 12px;
                    font-weight: i == root.current && !Look.fluent ? 500 : 400;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }

            if Look.fluent && i == root.current: Rectangle {
                x: (parent.width - self.width) / 2;
                y: parent.height - 4px;
                width: 16px;
                height: 3px;
                border-radius: 1.5px;
                background: Look.accent;
            }

            touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.chosen(i);
                }
            }
        }
    }
}

// Many choices (themes, opacities): ‹ the one chosen ›.
component Stepper inherits Rectangle {
    in property <[string]> labels;
    in property <int> current;
    callback chosen(int);
    height: Look.fluent ? 32px : 28px;
    width: 170px;
    border-radius: Look.fluent ? 4px : 7px;
    background: Look.fluent ? Look.control : Theme.ink.with-alpha(Theme.dark ? 0.07 : 0.06);
    border-width: Look.fluent ? 1px : 0px;
    border-color: Look.control-stroke;
    HorizontalLayout {
        Rectangle {
            width: 30px;
            background: Look.fluent && back.has-hover ? Look.subtle : transparent;
            border-radius: 4px;
            Text {
                text: "‹";
                color: Look.fluent ? Look.ink-2 : back.has-hover ? Theme.ink : Theme.ink-3;
                font-size: 16px;
            }

            back := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.chosen(Math.mod(root.current - 1 + root.labels.length, root.labels.length));
                }
            }
        }

        Text {
            horizontal-stretch: 1;
            text: root.labels[root.current];
            color: Look.fluent ? Look.ink : Theme.ink;
            font-size: Look.fluent ? 14px : 12px;
            font-weight: Look.fluent ? 400 : 500;
            vertical-alignment: center;
            horizontal-alignment: center;
            overflow: elide;
        }

        Rectangle {
            width: 30px;
            background: Look.fluent && next.has-hover ? Look.subtle : transparent;
            border-radius: 4px;
            Text {
                text: "›";
                color: Look.fluent ? Look.ink-2 : next.has-hover ? Theme.ink : Theme.ink-3;
                font-size: 16px;
            }

            next := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.chosen(Math.mod(root.current + 1, root.labels.length));
                }
            }
        }
    }
}

component Button inherits Rectangle {
    in property <string> label;
    in property <bool> primary;
    callback clicked();
    height: Look.fluent ? 32px : 30px;
    border-radius: Look.fluent ? 4px : 7px;
    background: Look.fluent
        ? (root.primary ? (touch.has-hover ? Look.accent.with-alpha(0.9) : Look.accent) : (touch.pressed ? Look.control-pressed : touch.has-hover ? Look.control-hover : Look.control))
        : (root.primary ? (touch.has-hover ? Theme.ink : Theme.ink.with-alpha(0.92)) : (touch.has-hover ? Theme.ink.with-alpha(0.12) : Theme.ink.with-alpha(0.08)));
    border-width: Look.fluent && !root.primary ? 1px : 0px;
    border-color: Look.control-stroke;
    HorizontalLayout {
        padding-left: Look.fluent ? 12px : 14px;
        padding-right: Look.fluent ? 12px : 14px;
        Text {
            text: root.label;
            color: Look.fluent ? (root.primary ? Look.on-accent : Look.ink) : (root.primary ? Theme.bg : Theme.ink);
            font-size: Look.fluent ? 14px : 13px;
            font-weight: Look.fluent ? 400 : 500;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component Field inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text;
    callback edited(string);
    height: Look.fluent ? 32px : 30px;
    border-radius: Look.fluent ? 4px : 6px;
    background: Look.fluent
        ? (input.has-focus ? (Theme.dark ? #1e1e1e : #ffffff) : Look.control)
        : (Theme.dark ? Theme.ink.with-alpha(0.05) : #ffffff);
    border-width: 1px;
    border-color: Look.fluent ? Look.control-stroke : input.has-focus ? Theme.highlight : Theme.line;
    input := TextInput {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        vertical-alignment: center;
        single-line: true;
        text <=> root.text;
        color: Look.fluent ? Look.ink : Theme.ink;
        font-size: Look.fluent ? 14px : 13px;
        selection-background-color: Look.fluent ? Look.accent.with-alpha(0.5) : Theme.highlight.with-alpha(0.4);
        selection-foreground-color: Look.fluent ? Look.ink : Theme.ink;
        edited => {
            root.edited(self.text);
        }
    }

    if root.text == "": Text {
        x: 10px;
        height: parent.height;
        vertical-alignment: center;
        text: root.placeholder;
        color: Look.fluent ? Look.ink-3 : Theme.ink-3;
        font-size: Look.fluent ? 14px : 13px;
    }

    // Windows marks a text box along its bottom edge: thin, or the accent while you type.
    if Look.fluent: Rectangle {
        x: 2px;
        width: parent.width - 4px;
        y: parent.height - self.height;
        height: input.has-focus ? 2px : 1px;
        background: input.has-focus ? Look.accent : Look.strong-stroke.with-alpha(0.6);
    }
}

// A rounded panel. Tendril's holds a group of rows; Windows' holds one setting each.
component Card inherits Rectangle {
    border-radius: Look.fluent ? 6px : 10px;
    background: Look.fluent ? Look.card : Theme.dark ? Theme.ink.with-alpha(0.04) : #ffffff;
    border-width: 1px;
    border-color: Look.fluent ? Look.card-stroke : Theme.line.with-alpha(0.8);
    clip: true;
}

component ChoiceRow inherits Rectangle {
    in property <Choice> data;
    in property <bool> last;
    callback chosen(int);
    height: Look.fluent ? 66px : 58px;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: Look.fluent ? 16px : 14px;
        spacing: 16px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.data.title;
                color: Look.fluent ? Look.ink : Theme.ink;
                font-size: Look.fluent ? 14px : 13px;
                font-weight: Look.fluent ? 400 : 500;
            }

            if root.data.about != "": Text {
                text: root.data.about;
                color: Look.fluent ? Look.ink-2 : Theme.ink-3;
                font-size: 12px;
                overflow: elide;
            }
        }

        // Windows says On or Off beside a switch.
        if Look.fluent && root.data.toggle: Text {
            text: root.data.current == 0 ? "On" : "Off";
            color: Look.ink;
            font-size: 14px;
            vertical-alignment: center;
        }

        VerticalLayout {
            alignment: center;
            if root.data.toggle: Switch {
                on: root.data.current == 0;
                toggled => {
                    root.chosen(root.data.current == 0 ? 1 : 0);
                }
            }
            if !root.data.toggle && root.data.labels.length <= 4: Segmented {
                labels: root.data.labels;
                current: root.data.current;
                chosen(i) => {
                    root.chosen(i);
                }
            }
            if !root.data.toggle && root.data.labels.length > 4: Stepper {
                labels: root.data.labels;
                current: root.data.current;
                chosen(i) => {
                    root.chosen(i);
                }
            }
        }
    }

    if !root.last && !Look.fluent: Rectangle {
        x: 16px;
        y: root.height - 1px;
        width: root.width - 16px;
        height: 1px;
        background: Theme.line.with-alpha(0.7);
    }
}

component GroupTitle inherits Text {
    color: Look.fluent ? Look.ink : Theme.ink-3;
    font-size: Look.fluent ? 14px : 12px;
    font-weight: Look.fluent ? 600 : 500;
}

component Groups inherits VerticalLayout {
    in property <[ChoiceGroup]> groups;
    callback chosen(string, int);
    spacing: 8px;
    for group in root.groups: VerticalLayout {
        spacing: 8px;
        padding-bottom: 12px;
        GroupTitle {
            text: group.title;
        }

        // Tendril's: the group's rows in one panel.
        if !Look.fluent: Card {
            VerticalLayout {
                for choice[i] in group.choices: ChoiceRow {
                    data: choice;
                    last: i == group.choices.length - 1;
                    chosen(index) => {
                        root.chosen(choice.key, index);
                    }
                }
            }
        }

        // Windows': a card for each.
        if Look.fluent: VerticalLayout {
            spacing: 3px;
            for choice in group.choices: Card {
                height: 66px;
                ChoiceRow {
                    data: choice;
                    last: true;
                    chosen(index) => {
                        root.chosen(choice.key, index);
                    }
                }
            }
        }
    }
}

// A list of one-line entries you can edit, add to and remove from: folders, patterns.
component TextList inherits VerticalLayout {
    in property <string> title;
    in property <string> about;
    in property <[string]> entries;
    in property <string> placeholder;
    in property <string> add-label;
    callback edited(int, string);
    callback add();
    callback remove(int);
    spacing: 8px;
    GroupTitle {
        text: root.title;
    }

    Text {
        text: root.about;
        color: Look.fluent ? Look.ink-3 : Theme.ink-3;
        font-size: 12px;
        wrap: word-wrap;
    }

    for entry[i] in root.entries: Card {
        HorizontalLayout {
            padding: 10px;
            spacing: 8px;
            Field {
                horizontal-stretch: 1;
                text: entry;
                placeholder: root.placeholder;
                edited(t) => {
                    root.edited(i, t);
                }
            }

            Button {
                label: "Remove";
                clicked => {
                    root.remove(i);
                }
            }
        }
    }

    HorizontalLayout {
        alignment: start;
        Button {
            label: root.add-label;
            clicked => {
                root.add();
            }
        }
    }
}

component Tab inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> selected;
    callback clicked();
    height: Look.fluent ? 36px : 32px;
    border-radius: Look.fluent ? 4px : 7px;
    background: Look.fluent
        ? (root.selected || touch.has-hover ? Look.subtle : transparent)
        : (root.selected ? Theme.selection.with-alpha(Theme.selection-alpha * 1.4) : (touch.has-hover ? Theme.ink.with-alpha(0.04) : transparent));
    HorizontalLayout {
        padding-left: Look.fluent ? 14px : 10px;
        spacing: Look.fluent ? 14px : 10px;
        Image {
            width: 16px;
            source: root.icon;
            colorize: Look.fluent ? Look.ink : root.selected ? Theme.ink : Theme.ink-2;
            image-fit: contain;
            y: (parent.height - self.height) / 2;
            height: 16px;
        }

        Text {
            text: root.label;
            color: Look.fluent ? Look.ink : root.selected ? Theme.ink : Theme.ink-2;
            font-size: Look.fluent ? 14px : 13px;
            font-weight: root.selected && !Look.fluent ? 500 : 400;
            vertical-alignment: center;
        }
    }

    // Windows marks the page you're on with a pill of the accent.
    if Look.fluent && root.selected: Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: 16px;
        border-radius: 1.5px;
        background: Look.accent;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Minimize or close, at the top right, as Windows draws them: red under the pointer for close.
component CaptionButton inherits Rectangle {
    in property <bool> close;
    callback clicked();
    width: 46px;
    height: Look.fluent ? 32px : 36px;
    background: touch.has-hover ? (root.close ? #c42b1c : Look.fluent ? Look.subtle : Theme.ink.with-alpha(touch.pressed ? 0.12 : 0.07)) : transparent;
    animate background { duration: 90ms; }
    Path {
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        stroke: touch.has-hover && root.close ? white : Look.fluent ? Look.ink : Theme.ink-2;
        stroke-width: 1px;
        commands: root.close ? "M 0 0 L 10 10 M 10 0 L 0 10" : "M 0 5 L 10 5";
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component SettingsWindow inherits Window {
    title: "Tendril Settings";
    icon: @image-url("../assets/tendril-256.png");
    width: 800px;
    height: 560px;
    // Without the system's frame, Tendril draws its own (settings.rs says where).
    no-frame: frameless;
    background: Look.mica || corner > 0 ? transparent : Look.fluent ? Look.base : Theme.panel;
    // Segoe UI Variable on Windows 11; Windows 10 falls back to Segoe UI.
    default-font-family: Look.fluent ? "Segoe UI Variable Text" : "Geist";
    default-font-size: Look.fluent ? 14px : 13px;

    in-out property <int> tab;
    in property <[ChoiceGroup]> general;
    in property <[ChoiceGroup]> look;
    in property <[ChoiceGroup]> layout;
    in property <[Entry]> engines;
    in property <[Entry]> links;
    // File search: its settings, how the index stands, and its lists.
    in property <[ChoiceGroup]> files;
    in property <string> files-status;
    in property <[string]> folders;
    in property <[string]> include;
    in property <[string]> exclude;
    in property <[string]> exclude-regex;
    in property <[string]> shortcut-keys;
    in property <string> shortcut-note;
    in property <bool> shortcut-ok: true;
    in-out property <bool> recording;
    in property <string> version;
    in property <string> update-note;

    in property <bool> frameless;
    // Rounded by Slint (Linux); Windows 11 and macOS round windows themselves.
    in property <length> corner;
    // Room at the top for the system's own buttons (macOS).
    in property <length> top-inset;
    // Windows 11 apps with a pane down the side have a taller title bar.
    property <length> bar: Look.fluent ? 44px : frameless ? 36px : 0px;

    in property <bool> confirm-open;
    in property <string> confirm-title;
    in property <string> confirm-message;
    in property <string> confirm-label;
    in property <image> confirm-icon;

    callback chosen(string, int);
    callback record(string, bool, bool, bool, bool) -> bool;
    callback start-recording();
    callback stop-recording();
    callback engine-edited(int, string, string);
    callback engine-add();
    callback engine-remove(int);
    callback link-edited(int, string, string);
    callback link-add();
    callback link-remove(int);
    // Which list ("folders", "include", "exclude", "exclude_regex"), and where in it.
    callback list-edited(string, int, string);
    callback list-add(string);
    callback list-remove(string, int);
    callback index-now();
    callback check-updates();
    callback open-file();
    callback answer(bool);
    callback dismiss();
    callback drag();
    callback minimize();

    forward-focus: keys;
    Rectangle {
        border-radius: root.corner;
        clip: root.corner > 0;
        background: Look.mica ? transparent : Look.fluent ? Look.base : Theme.panel;
        border-width: root.corner > 0 ? 1px : 0px;
        border-color: Theme.line;

        keys := FocusScope {
            capture-key-pressed(e) => {
                if root.confirm-open {
                    if e.text == Key.Escape {
                        root.answer(false);
                    } else if e.text == Key.Return {
                        root.answer(true);
                    }
                    return accept;
                }
                if root.recording {
                    if e.text == Key.Escape {
                        root.stop-recording();
                        return accept;
                    }
                    if root.record(e.text, e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta) {
                        return accept;
                    }
                    return accept;
                }
                if e.text == Key.Escape || (e.modifiers.control && (e.text == "w" || e.text == "W")) {
                    root.dismiss();
                    return accept;
                }
                // Tabs from the keyboard: Ctrl Tab and Ctrl Shift Tab, Ctrl 1 to 7, or ↑ ↓ when no
                // field has the keys.
                if e.modifiers.control && e.text == Key.Tab && !e.modifiers.shift {
                    root.tab = Math.mod(root.tab + 1, 7);
                    return accept;
                }
                if e.modifiers.control && (e.text == Key.Backtab || (e.text == Key.Tab && e.modifiers.shift)) {
                    root.tab = Math.mod(root.tab + 6, 7);
                    return accept;
                }
                if e.modifiers.control && (e.text == "1" || e.text == "2" || e.text == "3" || e.text == "4" || e.text == "5" || e.text == "6" || e.text == "7") {
                    root.tab = e.text.to-float() - 1;
                    return accept;
                }
                if keys.has-focus && e.text == Key.DownArrow {
                    root.tab = min(root.tab + 1, 6);
                    return accept;
                }
                if keys.has-focus && e.text == Key.UpArrow {
                    root.tab = max(root.tab - 1, 0);
                    return accept;
                }
                reject
            }

            HorizontalLayout {
                // The tabs.
                Rectangle {
                    width: Look.fluent ? 220px : 196px;
                    // Windows' pane sits on the window itself.
                    background: Look.fluent ? transparent : Theme.dark ? Theme.sunken : Theme.bg;
                    // The software renderer doesn't clip to rounded corners, so the sidebar
                    // rounds its own.
                    border-top-left-radius: root.corner;
                    border-bottom-left-radius: root.corner;
                    VerticalLayout {
                        padding: Look.fluent ? 6px : 12px;
                        padding-left: Look.fluent ? 6px : 12px;
                        padding-top: Look.fluent ? root.bar : root.frameless ? 8px : 16px + root.top-inset;
                        spacing: 2px;
                        alignment: start;
                        // Windows puts the name in the title bar instead.
                        if !Look.fluent: Text {
                            text: "Settings";
                            color: Theme.ink;
                            font-size: 15px;
                            font-weight: 600;
                            height: 34px;
                            vertical-alignment: center;
                            x: 10px;
                        }

                        Tab {
                            label: "General";
                            icon: @image-url("icons/settings.svg");
                            selected: root.tab == 0;
                            clicked => {
                                root.tab = 0;
                            }
                        }

                        Tab {
                            label: "Appearance";
                            icon: @image-url("icons/palette.svg");
                            selected: root.tab == 1;
                            clicked => {
                                root.tab = 1;
                            }
                        }

                        Tab {
                            label: "Layout";
                            icon: @image-url("icons/columns.svg");
                            selected: root.tab == 2;
                            clicked => {
                                root.tab = 2;
                            }
                        }

                        Tab {
                            label: "Search Engines";
                            icon: @image-url("icons/globe.svg");
                            selected: root.tab == 3;
                            clicked => {
                                root.tab = 3;
                            }
                        }

                        Tab {
                            label: "Quicklinks";
                            icon: @image-url("icons/link.svg");
                            selected: root.tab == 4;
                            clicked => {
                                root.tab = 4;
                            }
                        }

                        Tab {
                            label: "Files";
                            icon: @image-url("icons/folder.svg");
                            selected: root.tab == 5;
                            clicked => {
                                root.tab = 5;
                            }
                        }

                        Tab {
                            label: "About";
                            icon: @image-url("icons/tendril.svg");
                            selected: root.tab == 6;
                            clicked => {
                                root.tab = 6;
                            }
                        }
                    }

                    if !Look.fluent: Rectangle {
                        x: parent.width - 1px;
                        width: 1px;
                        background: Theme.line;
                    }
                }

                // The tab's page.
                VerticalLayout {
                    horizontal-stretch: 1;
                    Rectangle {
                        height: root.bar;
                    }

                    page := Flickable {
                        horizontal-stretch: 1;
                        content-height: max(content.preferred-height, self.height);
                        content := VerticalLayout {
                            padding: 28px;
                            padding-left: Look.fluent ? 20px : 28px;
                            padding-top: Look.fluent ? 4px : root.frameless ? 6px : 24px;
                            spacing: Look.fluent ? 20px : 18px;
                            alignment: start;
                            Text {
                                text: root.tab == 0 ? "General" : root.tab == 1 ? "Appearance" : root.tab == 2 ? "Layout" : root.tab == 3 ? "Search Engines" : root.tab == 4 ? "Quicklinks" : root.tab == 5 ? "Files" : "About";
                                color: Theme.ink;
                                // Windows' page titles are large.
                                font-size: Look.fluent ? 28px : 20px;
                                font-weight: 600;
                            }

                            if root.tab == 0: VerticalLayout {
                                spacing: 8px;
                                padding-bottom: 12px;
                                GroupTitle {
                                    text: "Shortcut";
                                }

                                Card {
                                    height: 64px;
                                    HorizontalLayout {
                                        padding-left: 16px;
                                        padding-right: 14px;
                                        spacing: 12px;
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;
                                            horizontal-stretch: 1;
                                            Text {
                                                text: "Open Tendril with";
                                                color: Theme.ink;
                                                font-size: 13px;
                                                font-weight: 500;
                                            }

                                            Text {
                                                text: root.recording ? "Press the keys you'd like. Esc stops." : root.shortcut-note;
                                                color: root.shortcut-ok || root.recording ? Theme.ink-3 : Theme.red;
                                                font-size: 12px;
                                                overflow: elide;
                                            }
                                        }

                                        HorizontalLayout {
                                            alignment: end;
                                            spacing: 4px;
                                            for key in root.shortcut-keys: VerticalLayout {
                                                alignment: center;
                                                Keycap {
                                                    label: key;
                                                    strong: true;
                                                    big: true;
                                                }
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            Button {
                                                label: root.recording ? "Stop" : "Change";
                                                primary: root.recording;
                                                clicked => {
                                                    if root.recording {
                                                        root.stop-recording();
                                                    } else {
                                                        root.start-recording();
                                                        keys.focus();
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            if root.tab == 0: Groups {
                                groups: root.general;
                                chosen(key, index) => {
                                    root.chosen(key, index);
                                }
                            }

                            if root.tab == 1: Groups {
                                groups: root.look;
                                chosen(key, index) => {
                                    root.chosen(key, index);
                                }
                            }

                            if root.tab == 2: Groups {
                                groups: root.layout;
                                chosen(key, index) => {
                                    root.chosen(key, index);
                                }
                            }

                            if root.tab == 3: VerticalLayout {
                                spacing: 10px;
                                Text {
                                    text: "Offered under your results as \"Search Google\" and the like. {query} is what you typed.";
                                    color: Theme.ink-3;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }

                                for engine[i] in root.engines: Card {
                                    HorizontalLayout {
                                        padding: 10px;
                                        spacing: 8px;
                                        Field {
                                            width: 150px;
                                            text: engine.name;
                                            placeholder: "Name";
                                            edited(t) => {
                                                root.engine-edited(i, "name", t);
                                            }
                                        }

                                        Field {
                                            horizontal-stretch: 1;
                                            text: engine.url;
                                            placeholder: "https://example.com/search?q={query}";
                                            edited(t) => {
                                                root.engine-edited(i, "url", t);
                                            }
                                        }

                                        Button {
                                            label: "Remove";
                                            clicked => {
                                                root.engine-remove(i);
                                            }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    alignment: start;
                                    Button {
                                        label: "Add Search Engine";
                                        clicked => {
                                            root.engine-add();
                                        }
                                    }
                                }
                            }

                            if root.tab == 4: VerticalLayout {
                                spacing: 10px;
                                Text {
                                    text: "Type the keyword, a space and some text: {query} is that text made safe for a web address, {raw} is it as typed. A link with neither is a bookmark you find by name. Folders work too, like ~/Projects.";
                                    color: Theme.ink-3;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }

                                for link[i] in root.links: Card {
                                    HorizontalLayout {
                                        padding: 10px;
                                        spacing: 8px;
                                        Field {
                                            width: 150px;
                                            text: link.name;
                                            placeholder: "Name";
                                            edited(t) => {
                                                root.link-edited(i, "name", t);
                                            }
                                        }

                                        Field {
                                            width: 80px;
                                            text: link.keyword;
                                            placeholder: "Keyword";
                                            edited(t) => {
                                                root.link-edited(i, "keyword", t);
                                            }
                                        }

                                        Field {
                                            horizontal-stretch: 1;
                                            text: link.url;
                                            placeholder: "https://github.com/{raw}";
                                            edited(t) => {
                                                root.link-edited(i, "url", t);
                                            }
                                        }

                                        Button {
                                            label: "Remove";
                                            clicked => {
                                                root.link-remove(i);
                                            }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    alignment: start;
                                    Button {
                                        label: "Add Quicklink";
                                        clicked => {
                                            root.link-add();
                                        }
                                    }
                                }
                            }

                            if root.tab == 5: VerticalLayout {
                                spacing: 18px;
                                Card {
                                    height: 64px;
                                    HorizontalLayout {
                                        padding-left: 16px;
                                        padding-right: 14px;
                                        spacing: 12px;
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;
                                            horizontal-stretch: 1;
                                            Text {
                                                text: "Index";
                                                color: Look.fluent ? Look.ink : Theme.ink;
                                                font-size: 13px;
                                                font-weight: 500;
                                            }

                                            Text {
                                                text: root.files-status;
                                                color: Look.fluent ? Look.ink-3 : Theme.ink-3;
                                                font-size: 12px;
                                                overflow: elide;
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            Button {
                                                label: "Index Now";
                                                clicked => {
                                                    root.index-now();
                                                }
                                            }
                                        }
                                    }
                                }

                                Groups {
                                    groups: root.files;
                                    chosen(key, index) => {
                                        root.chosen(key, index);
                                    }
                                }

                                TextList {
                                    title: "Folders";
                                    about: root.folders.length == 0 ? "None listed, so your usual folders are looked through: Desktop, Documents, Downloads, Pictures, Music and Videos." : "Looked through for file search, and the folders inside them.";
                                    entries: root.folders;
                                    placeholder: "~/Projects or D:/Work";
                                    add-label: "Add Folder";
                                    edited(i, t) => {
                                        root.list-edited("folders", i, t);
                                    }
                                    add => {
                                        root.list-add("folders");
                                    }
                                    remove(i) => {
                                        root.list-remove("folders", i);
                                    }
                                }

                                TextList {
                                    title: "Only these files";
                                    about: "Written like a .gitignore line, such as *.pdf. With none, every file is found. Folders are always found.";
                                    entries: root.include;
                                    placeholder: "*.pdf";
                                    add-label: "Add Pattern";
                                    edited(i, t) => {
                                        root.list-edited("include", i, t);
                                    }
                                    add => {
                                        root.list-add("include");
                                    }
                                    remove(i) => {
                                        root.list-remove("include", i);
                                    }
                                }

                                TextList {
                                    title: "Left out";
                                    about: "Written like a .gitignore line: node_modules is any file or folder by that name, *.log any name ending so, ~/Downloads/old that one folder.";
                                    entries: root.exclude;
                                    placeholder: "node_modules";
                                    add-label: "Add Pattern";
                                    edited(i, t) => {
                                        root.list-edited("exclude", i, t);
                                    }
                                    add => {
                                        root.list-add("exclude");
                                    }
                                    remove(i) => {
                                        root.list-remove("exclude", i);
                                    }
                                }

                                TextList {
                                    title: "Left out by regular expression";
                                    about: "Matched against the whole path, written with / between folders on every system.";
                                    entries: root.exclude-regex;
                                    placeholder: "/build/";
                                    add-label: "Add Expression";
                                    edited(i, t) => {
                                        root.list-edited("exclude_regex", i, t);
                                    }
                                    add => {
                                        root.list-add("exclude_regex");
                                    }
                                    remove(i) => {
                                        root.list-remove("exclude_regex", i);
                                    }
                                }
                            }

                            if root.tab == 6: VerticalLayout {
                                spacing: 14px;
                                HorizontalLayout {
                                    spacing: 16px;
                                    alignment: start;
                                    // The mark, drawn from its SVG so it's sharp at any scale.
                                    Image {
                                        width: 72px;
                                        height: 72px;
                                        source: @image-url("../assets/tendril.svg");
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        Text {
                                            text: "Tendril";
                                            color: Theme.ink;
                                            font-size: 18px;
                                            font-weight: 600;
                                        }

                                        Text {
                                            text: "Version " + root.version;
                                            color: Theme.ink-3;
                                            font-size: 12px;
                                        }
                                    }
                                }

                                Text {
                                    text: "A keyboard launcher. No web views, no tracking. Made by Loam, alongside Blight. GPL-3.0.";
                                    color: Theme.ink-2;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }

                                HorizontalLayout {
                                    alignment: start;
                                    spacing: 8px;
                                    Button {
                                        label: "Check for Updates";
                                        clicked => {
                                            root.check-updates();
                                        }
                                    }

                                    Button {
                                        label: "Open Settings File";
                                        clicked => {
                                            root.open-file();
                                        }
                                    }
                                }

                                if root.update-note != "": Text {
                                    text: root.update-note;
                                    color: Theme.ink-3;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }
        }

        // The title bar, where the system draws none: drag anywhere along the top.
        if root.frameless: Rectangle {
            y: 0;
            height: root.bar;
            // Windows 11's title bar: the app's icon and name on the left.
            if Look.fluent: Image {
                x: 16px;
                y: (32px - self.height) / 2 + 4px;
                width: 16px;
                height: 16px;
                source: @image-url("../assets/tendril-small.svg");
            }
            if Look.fluent: Text {
                x: 44px;
                y: 4px;
                height: 32px;
                vertical-alignment: center;
                text: "Tendril Settings";
                color: Look.ink;
                font-size: 12px;
            }

            TouchArea {
                x: 0;
                width: parent.width - 92px;
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                        root.drag();
                    }
                }
            }

            CaptionButton {
                x: parent.width - 92px;
                close: false;
                clicked => {
                    root.minimize();
                }
            }

            CaptionButton {
                x: parent.width - 46px;
                close: true;
                clicked => {
                    root.dismiss();
                }
            }
        }

        if root.confirm-open: ConfirmDialog {
            width: root.width;
            height: root.height;
            border-radius: root.corner;
            title: root.confirm-title;
            message: root.confirm-message;
            label: root.confirm-label;
            icon: root.confirm-icon;
            danger: false;
            answer(yes) => {
                root.answer(yes);
            }
        }
    }
}
