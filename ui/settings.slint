// Tendril's Settings window, in the manner of Raycast's: tabs down the side, each setting a row
// with its control on the right, saved the moment it changes. Made when it's opened and gone when
// it's closed (settings.rs), so it costs nothing the rest of the time.

import { Theme } from "theme.slint";
import { Keycap, ConfirmDialog } from "parts.slint";

export struct Choice {
    key: string,
    title: string,
    about: string,
    labels: [string],
    current: int,
    // On and Off, drawn as a switch.
    toggle: bool,
}

export struct ChoiceGroup {
    title: string,
    choices: [Choice],
}

export struct Entry {
    name: string,
    keyword: string,
    url: string,
}

component Switch inherits Rectangle {
    in property <bool> on;
    callback toggled();
    width: 36px;
    height: 20px;
    border-radius: 10px;
    background: on ? Theme.highlight : Theme.ink.with-alpha(Theme.dark ? 0.18 : 0.16);
    animate background { duration: 120ms; }
    Rectangle {
        y: 2px;
        x: root.on ? root.width - self.width - 2px : 2px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: #ffffff;
        drop-shadow-blur: 2px;
        drop-shadow-color: #00000040;
        animate x {
            duration: 120ms;
            easing: cubic-bezier(0.2, 0, 0, 1);
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.toggled();
        }
    }
}

// A few choices side by side, the chosen one raised.
component Segmented inherits Rectangle {
    in property <[string]> labels;
    in property <int> current;
    callback chosen(int);
    height: 28px;
    border-radius: 7px;
    background: Theme.ink.with-alpha(Theme.dark ? 0.07 : 0.06);
    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for label[i] in root.labels: Rectangle {
            border-radius: 5px;
            background: i == root.current ? (Theme.dark ? Theme.ink.with-alpha(0.15) : #ffffff) : (touch.has-hover ? Theme.ink.with-alpha(0.05) : transparent);
            drop-shadow-blur: i == root.current && !Theme.dark ? 2px : 0;
            drop-shadow-color: #00000026;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                Text {
                    text: label;
                    color: i == root.current ? Theme.ink : Theme.ink-2;
                    font-size: 12px;
                    font-weight: i == root.current ? 500 : 400;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }

            touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.chosen(i);
                }
            }
        }
    }
}

// Many choices (themes, opacities): ‹ the one chosen ›.
component Stepper inherits Rectangle {
    in property <[string]> labels;
    in property <int> current;
    callback chosen(int);
    height: 28px;
    width: 170px;
    border-radius: 7px;
    background: Theme.ink.with-alpha(Theme.dark ? 0.07 : 0.06);
    HorizontalLayout {
        Rectangle {
            width: 28px;
            Text {
                text: "‹";
                color: back.has-hover ? Theme.ink : Theme.ink-3;
                font-size: 16px;
            }

            back := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.chosen(Math.mod(root.current - 1 + root.labels.length, root.labels.length));
                }
            }
        }

        Text {
            horizontal-stretch: 1;
            text: root.labels[root.current];
            color: Theme.ink;
            font-size: 12px;
            font-weight: 500;
            vertical-alignment: center;
            horizontal-alignment: center;
            overflow: elide;
        }

        Rectangle {
            width: 28px;
            Text {
                text: "›";
                color: next.has-hover ? Theme.ink : Theme.ink-3;
                font-size: 16px;
            }

            next := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.chosen(Math.mod(root.current + 1, root.labels.length));
                }
            }
        }
    }
}

component Button inherits Rectangle {
    in property <string> label;
    in property <bool> primary;
    callback clicked();
    height: 30px;
    border-radius: 7px;
    background: primary ? (touch.has-hover ? Theme.ink : Theme.ink.with-alpha(0.92)) : (touch.has-hover ? Theme.ink.with-alpha(0.12) : Theme.ink.with-alpha(0.08));
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        Text {
            text: root.label;
            color: root.primary ? Theme.bg : Theme.ink;
            font-size: 13px;
            font-weight: 500;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component Field inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text;
    callback edited(string);
    height: 30px;
    border-radius: 6px;
    background: Theme.dark ? Theme.ink.with-alpha(0.05) : #ffffff;
    border-width: 1px;
    border-color: input.has-focus ? Theme.highlight : Theme.line;
    input := TextInput {
        x: 9px;
        width: parent.width - 18px;
        height: parent.height;
        vertical-alignment: center;
        single-line: true;
        text <=> root.text;
        color: Theme.ink;
        font-size: 13px;
        selection-background-color: Theme.highlight.with-alpha(0.4);
        selection-foreground-color: Theme.ink;
        edited => {
            root.edited(self.text);
        }
    }

    if root.text == "": Text {
        x: 9px;
        height: parent.height;
        vertical-alignment: center;
        text: root.placeholder;
        color: Theme.ink-3;
        font-size: 13px;
    }
}

component ChoiceRow inherits Rectangle {
    in property <Choice> data;
    in property <bool> last;
    callback chosen(int);
    height: 58px;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 14px;
        spacing: 16px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.data.title;
                color: Theme.ink;
                font-size: 13px;
                font-weight: 500;
            }

            if root.data.about != "": Text {
                text: root.data.about;
                color: Theme.ink-3;
                font-size: 12px;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            if root.data.toggle: Switch {
                on: root.data.current == 0;
                toggled => {
                    root.chosen(root.data.current == 0 ? 1 : 0);
                }
            }
            if !root.data.toggle && root.data.labels.length <= 4: Segmented {
                labels: root.data.labels;
                current: root.data.current;
                chosen(i) => {
                    root.chosen(i);
                }
            }
            if !root.data.toggle && root.data.labels.length > 4: Stepper {
                labels: root.data.labels;
                current: root.data.current;
                chosen(i) => {
                    root.chosen(i);
                }
            }
        }
    }

    if !root.last: Rectangle {
        x: 16px;
        y: root.height - 1px;
        width: root.width - 16px;
        height: 1px;
        background: Theme.line.with-alpha(0.7);
    }
}

// A rounded panel the rows sit in.
component Card inherits Rectangle {
    border-radius: 10px;
    background: Theme.dark ? Theme.ink.with-alpha(0.04) : #ffffff;
    border-width: 1px;
    border-color: Theme.line.with-alpha(0.8);
    clip: true;
}

component GroupTitle inherits Text {
    color: Theme.ink-3;
    font-size: 12px;
    font-weight: 500;
}

component Groups inherits VerticalLayout {
    in property <[ChoiceGroup]> groups;
    callback chosen(string, int);
    spacing: 8px;
    for group in root.groups: VerticalLayout {
        spacing: 8px;
        padding-bottom: 12px;
        GroupTitle {
            text: group.title;
        }

        Card {
            VerticalLayout {
                for choice[i] in group.choices: ChoiceRow {
                    data: choice;
                    last: i == group.choices.length - 1;
                    chosen(index) => {
                        root.chosen(choice.key, index);
                    }
                }
            }
        }
    }
}

component Tab inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> selected;
    callback clicked();
    height: 32px;
    border-radius: 7px;
    background: selected ? Theme.selection.with-alpha(Theme.selection-alpha * 1.4) : (touch.has-hover ? Theme.ink.with-alpha(0.04) : transparent);
    HorizontalLayout {
        padding-left: 10px;
        spacing: 10px;
        Image {
            width: 16px;
            source: root.icon;
            colorize: root.selected ? Theme.ink : Theme.ink-2;
            image-fit: contain;
            y: (parent.height - self.height) / 2;
            height: 16px;
        }

        Text {
            text: root.label;
            color: root.selected ? Theme.ink : Theme.ink-2;
            font-size: 13px;
            font-weight: root.selected ? 500 : 400;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Minimize or close, at the top right, as Windows draws them: red under the pointer for close.
component CaptionButton inherits Rectangle {
    in property <bool> close;
    callback clicked();
    width: 46px;
    height: 36px;
    background: touch.has-hover ? (close ? #c42b1c : Theme.ink.with-alpha(touch.pressed ? 0.12 : 0.07)) : transparent;
    animate background { duration: 90ms; }
    Path {
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        stroke: touch.has-hover && root.close ? white : Theme.ink-2;
        stroke-width: 1px;
        commands: root.close ? "M 0 0 L 10 10 M 10 0 L 0 10" : "M 0 5 L 10 5";
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component SettingsWindow inherits Window {
    title: "Tendril Settings";
    icon: @image-url("../assets/tendril-256.png");
    width: 800px;
    height: 560px;
    // Without the system's frame, Tendril draws its own (settings.rs says where).
    no-frame: frameless;
    background: corner > 0 ? transparent : Theme.panel;
    default-font-family: "Geist";
    default-font-size: 13px;

    in-out property <int> tab;
    in property <[ChoiceGroup]> general;
    in property <[ChoiceGroup]> look;
    in property <[ChoiceGroup]> layout;
    in property <[Entry]> engines;
    in property <[Entry]> links;
    in property <[string]> shortcut-keys;
    in property <string> shortcut-note;
    in property <bool> shortcut-ok: true;
    in-out property <bool> recording;
    in property <string> version;
    in property <string> update-note;

    in property <bool> frameless;
    // Rounded by Slint (Linux); Windows 11 and macOS round windows themselves.
    in property <length> corner;
    // Room at the top for the system's own buttons (macOS).
    in property <length> top-inset;
    property <length> bar: frameless ? 36px : 0px;

    in property <bool> confirm-open;
    in property <string> confirm-title;
    in property <string> confirm-message;
    in property <string> confirm-label;
    in property <image> confirm-icon;

    callback chosen(string, int);
    callback record(string, bool, bool, bool, bool) -> bool;
    callback start-recording();
    callback stop-recording();
    callback engine-edited(int, string, string);
    callback engine-add();
    callback engine-remove(int);
    callback link-edited(int, string, string);
    callback link-add();
    callback link-remove(int);
    callback check-updates();
    callback open-file();
    callback answer(bool);
    callback dismiss();
    callback drag();
    callback minimize();

    forward-focus: keys;
    Rectangle {
        border-radius: root.corner;
        clip: root.corner > 0;
        background: Theme.panel;
        border-width: root.corner > 0 ? 1px : 0px;
        border-color: Theme.line;

        keys := FocusScope {
            capture-key-pressed(e) => {
                if root.confirm-open {
                    if e.text == Key.Escape {
                        root.answer(false);
                    } else if e.text == Key.Return {
                        root.answer(true);
                    }
                    return accept;
                }
                if root.recording {
                    if e.text == Key.Escape {
                        root.stop-recording();
                        return accept;
                    }
                    if root.record(e.text, e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta) {
                        return accept;
                    }
                    return accept;
                }
                if e.text == Key.Escape || (e.modifiers.control && (e.text == "w" || e.text == "W")) {
                    root.dismiss();
                    return accept;
                }
                // Tabs from the keyboard: Ctrl Tab and Ctrl Shift Tab, Ctrl 1 to 6, or ↑ ↓ when no
                // field has the keys.
                if e.modifiers.control && e.text == Key.Tab && !e.modifiers.shift {
                    root.tab = Math.mod(root.tab + 1, 6);
                    return accept;
                }
                if e.modifiers.control && (e.text == Key.Backtab || (e.text == Key.Tab && e.modifiers.shift)) {
                    root.tab = Math.mod(root.tab + 5, 6);
                    return accept;
                }
                if e.modifiers.control && (e.text == "1" || e.text == "2" || e.text == "3" || e.text == "4" || e.text == "5" || e.text == "6") {
                    root.tab = e.text.to-float() - 1;
                    return accept;
                }
                if keys.has-focus && e.text == Key.DownArrow {
                    root.tab = min(root.tab + 1, 5);
                    return accept;
                }
                if keys.has-focus && e.text == Key.UpArrow {
                    root.tab = max(root.tab - 1, 0);
                    return accept;
                }
                reject
            }

            HorizontalLayout {
                // The tabs.
                Rectangle {
                    width: 196px;
                    background: Theme.dark ? Theme.sunken : Theme.bg;
                    // The software renderer doesn't clip to rounded corners, so the sidebar
                    // rounds its own.
                    border-top-left-radius: root.corner;
                    border-bottom-left-radius: root.corner;
                    VerticalLayout {
                        padding: 12px;
                        padding-top: root.frameless ? 8px : 16px + root.top-inset;
                        spacing: 2px;
                        alignment: start;
                        Text {
                            text: "Settings";
                            color: Theme.ink;
                            font-size: 15px;
                            font-weight: 600;
                            height: 34px;
                            vertical-alignment: center;
                            x: 10px;
                        }

                        Tab {
                            label: "General";
                            icon: @image-url("icons/settings.svg");
                            selected: root.tab == 0;
                            clicked => {
                                root.tab = 0;
                            }
                        }

                        Tab {
                            label: "Appearance";
                            icon: @image-url("icons/palette.svg");
                            selected: root.tab == 1;
                            clicked => {
                                root.tab = 1;
                            }
                        }

                        Tab {
                            label: "Layout";
                            icon: @image-url("icons/columns.svg");
                            selected: root.tab == 2;
                            clicked => {
                                root.tab = 2;
                            }
                        }

                        Tab {
                            label: "Search Engines";
                            icon: @image-url("icons/globe.svg");
                            selected: root.tab == 3;
                            clicked => {
                                root.tab = 3;
                            }
                        }

                        Tab {
                            label: "Quicklinks";
                            icon: @image-url("icons/link.svg");
                            selected: root.tab == 4;
                            clicked => {
                                root.tab = 4;
                            }
                        }

                        Tab {
                            label: "About";
                            icon: @image-url("icons/tendril.svg");
                            selected: root.tab == 5;
                            clicked => {
                                root.tab = 5;
                            }
                        }
                    }

                    Rectangle {
                        x: parent.width - 1px;
                        width: 1px;
                        background: Theme.line;
                    }
                }

                // The tab's page.
                VerticalLayout {
                    horizontal-stretch: 1;
                    Rectangle {
                        height: root.bar;
                    }

                    page := Flickable {
                        horizontal-stretch: 1;
                        content-height: max(content.preferred-height, self.height);
                        content := VerticalLayout {
                            padding: 28px;
                            padding-top: root.frameless ? 6px : 24px;
                            spacing: 18px;
                            alignment: start;
                            Text {
                                text: root.tab == 0 ? "General" : root.tab == 1 ? "Appearance" : root.tab == 2 ? "Layout" : root.tab == 3 ? "Search Engines" : root.tab == 4 ? "Quicklinks" : "About";
                                color: Theme.ink;
                                font-size: 20px;
                                font-weight: 600;
                            }

                            if root.tab == 0: VerticalLayout {
                                spacing: 8px;
                                padding-bottom: 12px;
                                GroupTitle {
                                    text: "Shortcut";
                                }

                                Card {
                                    height: 64px;
                                    HorizontalLayout {
                                        padding-left: 16px;
                                        padding-right: 14px;
                                        spacing: 12px;
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;
                                            horizontal-stretch: 1;
                                            Text {
                                                text: "Open Tendril with";
                                                color: Theme.ink;
                                                font-size: 13px;
                                                font-weight: 500;
                                            }

                                            Text {
                                                text: root.recording ? "Press the keys you'd like. Esc stops." : root.shortcut-note;
                                                color: root.shortcut-ok || root.recording ? Theme.ink-3 : Theme.red;
                                                font-size: 12px;
                                                overflow: elide;
                                            }
                                        }

                                        HorizontalLayout {
                                            alignment: end;
                                            spacing: 4px;
                                            for key in root.shortcut-keys: VerticalLayout {
                                                alignment: center;
                                                Keycap {
                                                    label: key;
                                                    strong: true;
                                                    big: true;
                                                }
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            Button {
                                                label: root.recording ? "Stop" : "Change";
                                                primary: root.recording;
                                                clicked => {
                                                    if root.recording {
                                                        root.stop-recording();
                                                    } else {
                                                        root.start-recording();
                                                        keys.focus();
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            if root.tab == 0: Groups {
                                groups: root.general;
                                chosen(key, index) => {
                                    root.chosen(key, index);
                                }
                            }

                            if root.tab == 1: Groups {
                                groups: root.look;
                                chosen(key, index) => {
                                    root.chosen(key, index);
                                }
                            }

                            if root.tab == 2: Groups {
                                groups: root.layout;
                                chosen(key, index) => {
                                    root.chosen(key, index);
                                }
                            }

                            if root.tab == 3: VerticalLayout {
                                spacing: 10px;
                                Text {
                                    text: "Offered under your results as \"Search Google\" and the like. {query} is what you typed.";
                                    color: Theme.ink-3;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }

                                for engine[i] in root.engines: Card {
                                    HorizontalLayout {
                                        padding: 10px;
                                        spacing: 8px;
                                        Field {
                                            width: 150px;
                                            text: engine.name;
                                            placeholder: "Name";
                                            edited(t) => {
                                                root.engine-edited(i, "name", t);
                                            }
                                        }

                                        Field {
                                            horizontal-stretch: 1;
                                            text: engine.url;
                                            placeholder: "https://example.com/search?q={query}";
                                            edited(t) => {
                                                root.engine-edited(i, "url", t);
                                            }
                                        }

                                        Button {
                                            label: "Remove";
                                            clicked => {
                                                root.engine-remove(i);
                                            }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    alignment: start;
                                    Button {
                                        label: "Add Search Engine";
                                        clicked => {
                                            root.engine-add();
                                        }
                                    }
                                }
                            }

                            if root.tab == 4: VerticalLayout {
                                spacing: 10px;
                                Text {
                                    text: "Type the keyword, a space and some text: {query} is that text made safe for a web address, {raw} is it as typed. A link with neither is a bookmark you find by name. Folders work too, like ~/Projects.";
                                    color: Theme.ink-3;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }

                                for link[i] in root.links: Card {
                                    HorizontalLayout {
                                        padding: 10px;
                                        spacing: 8px;
                                        Field {
                                            width: 150px;
                                            text: link.name;
                                            placeholder: "Name";
                                            edited(t) => {
                                                root.link-edited(i, "name", t);
                                            }
                                        }

                                        Field {
                                            width: 80px;
                                            text: link.keyword;
                                            placeholder: "Keyword";
                                            edited(t) => {
                                                root.link-edited(i, "keyword", t);
                                            }
                                        }

                                        Field {
                                            horizontal-stretch: 1;
                                            text: link.url;
                                            placeholder: "https://github.com/{raw}";
                                            edited(t) => {
                                                root.link-edited(i, "url", t);
                                            }
                                        }

                                        Button {
                                            label: "Remove";
                                            clicked => {
                                                root.link-remove(i);
                                            }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    alignment: start;
                                    Button {
                                        label: "Add Quicklink";
                                        clicked => {
                                            root.link-add();
                                        }
                                    }
                                }
                            }

                            if root.tab == 5: VerticalLayout {
                                spacing: 14px;
                                HorizontalLayout {
                                    spacing: 16px;
                                    alignment: start;
                                    Rectangle {
                                        width: 64px;
                                        height: 64px;
                                        border-radius: 15px;
                                        background: Theme.highlight;
                                        Image {
                                            width: 38px;
                                            height: 38px;
                                            source: @image-url("icons/tendril-solid.svg");
                                            colorize: #ffffff;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        Text {
                                            text: "Tendril";
                                            color: Theme.ink;
                                            font-size: 18px;
                                            font-weight: 600;
                                        }

                                        Text {
                                            text: "Version " + root.version;
                                            color: Theme.ink-3;
                                            font-size: 12px;
                                        }
                                    }
                                }

                                Text {
                                    text: "A keyboard launcher. No web views, no tracking. Made by Loam, alongside Blight. GPL-3.0.";
                                    color: Theme.ink-2;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }

                                HorizontalLayout {
                                    alignment: start;
                                    spacing: 8px;
                                    Button {
                                        label: "Check for Updates";
                                        clicked => {
                                            root.check-updates();
                                        }
                                    }

                                    Button {
                                        label: "Open Settings File";
                                        clicked => {
                                            root.open-file();
                                        }
                                    }
                                }

                                if root.update-note != "": Text {
                                    text: root.update-note;
                                    color: Theme.ink-3;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }
        }

        // The title bar, where the system draws none: drag anywhere along the top.
        if root.frameless: Rectangle {
            y: 0;
            height: root.bar;
            TouchArea {
                x: 0;
                width: parent.width - 92px;
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                        root.drag();
                    }
                }
            }

            CaptionButton {
                x: parent.width - 92px;
                close: false;
                clicked => {
                    root.minimize();
                }
            }

            CaptionButton {
                x: parent.width - 46px;
                close: true;
                clicked => {
                    root.dismiss();
                }
            }
        }

        if root.confirm-open: ConfirmDialog {
            width: root.width;
            height: root.height;
            border-radius: root.corner;
            title: root.confirm-title;
            message: root.confirm-message;
            label: root.confirm-label;
            icon: root.confirm-icon;
            danger: false;
            answer(yes) => {
                root.answer(yes);
            }
        }
    }
}
