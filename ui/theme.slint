// Colours come from the palette picked in config.toml (src/palettes.rs). These are Ember's,
// for the moment before Rust sets them. Tints are small marks of meaning, never a fill.
export global Theme {
    in property <color> sunken: #1a1918;
    in property <color> bg: #1f1e1d;
    in property <color> panel: #262624;
    in property <color> raised: #343330;
    in property <color> line: #3a3835;
    in property <color> ink: #f5f4ef;
    in property <color> ink-2: #a3a098;
    in property <color> ink-3: #87867f;
    in property <color> accent: #d97757;
    in property <color> blue: #6a9bcc;
    in property <color> green: #93a877;
    in property <color> red: #f06e64;
    in property <color> amber: #e49c42;
    in property <color> violet: #a99bd6;
    in property <bool> dark: true;
    // Appearance → Style, Selection and Icons. Modern only while the GPU renderer draws, since
    // the CPU one can't round a gradient.
    in property <bool> modern: false;
    in property <bool> blue-selection: false;
    in property <bool> bold-icons: false;
    // Windows 11's design, on Windows (src/fluent.rs): its greys and accent are put in the colours
    // above, and the parts drawn differently ask this.
    in property <bool> fluent: false;

    // The selected row's wash: white, or a soft blue.
    out property <color> selection: blue-selection ? blue.mix(ink, 0.7) : ink;
    out property <float> selection-alpha: blue-selection ? (dark ? 0.17 : 0.12) : fluent ? (dark ? 0.06 : 0.045) : (dark ? 0.085 : 0.06);

    // Blue leads, as on Blight's dashboard: selection, the highlighted row's icon, Tendril's mark.
    // White carries everything else; other colours only where they mean something.
    out property <color> highlight: blue;

    // Tint numbers, as Rust sends them: 0 means a real icon, drawn as it is; 7 is plain white.
    public pure function tint(n: int) -> color {
        if n == 1 { return accent; }
        if n == 2 { return blue; }
        if n == 3 { return green; }
        if n == 4 { return red; }
        if n == 5 { return amber; }
        if n == 6 { return violet; }
        return ink;
    }

    // How things move, as on the Blight dashboard: arrive with settle, leave fast.
    // 150ms for replies to a key, 250ms for most things.
    out property <duration> quick: 150ms;
    out property <duration> calm: 250ms;
}
